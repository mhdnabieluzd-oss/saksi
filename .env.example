# ==============================================================================
# SAKSI Platform Environment Configuration (.env.example)
# Copy to .env if using live LLM calls. No real secrets may be committed.
# When SAKSI_OPENROUTER_API_KEY is empty or SAKSI_FAST_DEMO=1, SAKSI runs in
# deterministic rule-based / template fallback mode (<5s full pipeline).
# ==============================================================================

# Server port (bound to 127.0.0.1 by default)
SAKSI_PORT=8000

# OpenRouter API configuration (optional — leave blank for deterministic fallback)
SAKSI_OPENROUTER_API_KEY=
SAKSI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary LLM model identifier on OpenRouter
SAKSI_MODEL=anthropic/claude-haiku-5.5

# Fast deterministic workflow mode (1 = instant deterministic mode, 0 = use LLM when key is set)
SAKSI_FAST_DEMO=1

# Self-declared default analyst display name (recorded in Chain of Custody ledger)
SAKSI_ANALYST=nabiel

# Default report classification header (SULIT | TERHAD | UNCLASSIFIED)
SAKSI_CLASSIFICATION=SULIT

# Configured local lab environment identifier required for live-lab response actions
SAKSI_LAB_ENV=LAB-LOCAL

# Custom data directory override (optional; defaults to backend/data)
# SAKSI_DATA_DIR=

